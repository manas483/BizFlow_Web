generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                  String                      @id @default(cuid())
  name                String
  gstNumber           String?
  ownerName           String
  phone               String
  address             String?
  state               String?
  stateCode           String?
  businessType        String
  plan                Plan                        @default(STARTER)
  createdAt           DateTime                    @default(now())
  accountNumber       String?
  bankName            String?
  branch              String?
  ifscCode            String?
  logoUrl             String?
  signatureUrl        String?
  gstInclusive        Boolean                     @default(false)
  onboardingCompleted Boolean                     @default(false)
  onboardingConfig    Json?
  attendanceRecords   AttendanceRecord[]
  billsOfSupply       BillOfSupply[]
  creditNotes         CreditNote[]
  customers           Customer[]
  debitNotes          DebitNote[]
  employees           Employee[]
  expenses            Expense[]
  notifications       Notification[]
  products            Product[]
  quotations          Quotation[]
  sales               Sale[]
  users               User[]
  userActivities      UserActivity[]
  invitations         Invitation[]
  leaveRequests       LeaveRequest[]
  attendanceTickets   AttendanceTicket[]
  refreshTokens       RefreshToken[]
  // ── Accounting & Finance relations ──
  accounts            Account[]
  journalEntries      JournalEntry[]
  bankAccounts        BankAccount[]
  cashBookEntries     CashBookEntry[]
  bankBookEntries     BankBookEntry[]
  bankReconciliations BankReconciliation[]
  gstReturns          GstReturn[]
  tdsEntries          TdsEntry[]
  accountsReceivable  AccountsReceivable[]
  accountsPayable     AccountsPayable[]
  // ── Loan & EMI relations ──
  loans               LoanMaster[]
  // ── Security & Administration relations ──
  customRoles         CustomRole[]
  auditLogs           AuditLog[]
  backupRecords       BackupRecord[]
  require2FA          Boolean                     @default(false)
  // ── Automation & AI relations ──
  automationSettings  AutomationSettings?
  warehouses          Warehouse[]
  aiForecasts         AiForecast[]
  stockMovements      StockMovement[]
  // ── Inventory Layer Costing relations ──
  inventoryLayers     InventoryLayer[]
  layerConsumptions   InventoryLayerConsumption[]
  periodClosings      InventoryPeriodClosing[]
  stockCounts         StockCount[]
  billsOfMaterial     BillOfMaterial[]
  // ── ML-Trained Invoice Templates ──
  invoiceTemplates    InvoiceTemplate[]
  // ── Phase 3 ──
  suppliers           Supplier[]
  purchases           Purchase[]
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String
  password            String?
  role                Role           @default(STAFF)
  businessId          String
  emailVerified       Boolean        @default(false)
  createdAt           DateTime       @default(now())
  // ── Two-Factor Authentication ──
  twoFactorEnabled    Boolean        @default(false)
  twoFactorSecret     String? // encrypted TOTP secret
  backupCodes         String[]       @default([]) // hashed backup codes
  twoFactorVerifiedAt DateTime? // when 2FA was first verified
  // ── Session Management ──
  sessionValidSince   DateTime       @default(now()) // used to revoke stateless JWTs
  business            Business       @relation(fields: [businessId], references: [id])
  employee            Employee?
  refreshTokens       RefreshToken[]
  deviceTokens        DeviceToken[]
}

/// Stores hashed OTPs for email verification. Auto-cleaned on use or expiry.
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  otpHash   String // bcrypt hash of the 6-digit OTP
  expiresAt DateTime
  attempts  Int      @default(0) // failed attempt counter — max 5
  createdAt DateTime @default(now())

  @@index([email])
}

model Invitation {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  role       Role
  businessId String
  expiresAt  DateTime
  used       Boolean  @default(false) // M-12: prevents token replay after acceptance
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, email])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  sku               String
  category          String
  stock             Int                @default(0)
  minStock          Int                @default(5)
  reorderLevel      Int                @default(0)
  reservedStock     Int                @default(0)
  standardCost      Float              @default(0)
  sellingPrice      Float
  supplier          String?
  preferredSupplier String?
  businessId        String
  active            Boolean            @default(true)
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  gstRate           Float              @default(0)
  hsnCode           String?
  unit              String             @default("pcs")
  unitsPerBag       Int                @default(1)
  purchaseDate      DateTime?
  purchaseFrom      String?
  purchaseInvoiceNo String?
  billItems         BillOfSupplyItem[]
  business          Business           @relation(fields: [businessId], references: [id])
  quotationItems    QuotationItem[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  inventoryLayers   InventoryLayer[]
  purchaseItems     PurchaseItem[]

  supplierId  String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id])

  @@index([businessId])
}

model Customer {
  id                 String               @id @default(cuid())
  name               String
  phone              String
  email              String?
  city               String?
  dues               Float                @default(0)
  totalPurchases     Float                @default(0)
  status             String               @default("active")
  businessId         String
  createdAt          DateTime             @default(now())
  address            String?
  gstNumber          String?
  state              String?
  stateCode          String?
  billsOfSupply      BillOfSupply[]
  creditNotes        CreditNote[]
  business           Business             @relation(fields: [businessId], references: [id])
  debitNotes         DebitNote[]
  quotations         Quotation[]
  sales              Sale[]
  accountsReceivable AccountsReceivable[]

  @@index([businessId])
}

model Sale {
  id             String    @id @default(cuid())
  invoiceNo      String
  customerId     String
  total          Float
  paid           Float     @default(0)
  status         String // payment status: paid | partial | unpaid
  notes          String?
  businessId     String
  createdAt      DateTime  @default(now())
  invoiceDate    DateTime? // user-specified invoice date (falls back to createdAt)
  placeOfSupply  String?
  reverseCharge  Boolean   @default(false)
  aggregateDate  String?
  isAggregate    Boolean   @default(false)
  // ── Phase 2: Workflow lifecycle ──
  workflowState  String    @default("posted") // draft | awaiting_approval | rejected | confirmed | posted
  paymentTerms   String? // immediate | 7_days | 15_days | 30_days | 45_days | 60_days | custom
  dueDate        DateTime? // auto-computed from invoiceDate + paymentTerms, or custom
  confirmedAt    DateTime? // when draft was confirmed (accounting event)
  confirmedBy    String? // userId who confirmed the draft
  draftSavedAt   DateTime? // last time draft was saved
  // ── Phase 3: Approvals ──
  approvalReason String?
  approvedBy     String?
  approvedAt     DateTime?

  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  payments    SalePayment[]
  business    Business      @relation(fields: [businessId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       SaleItem[]

  @@unique([businessId, invoiceNo])
}

model SaleItem {
  id                  String  @id @default(cuid())
  saleId              String
  productId           String
  qty                 Int
  price               Float
  purchasePrice       Float   @default(0) // Immutable snapshot of COGS at time of sale
  gstRate             Float   @default(0)
  hsnCode             String?
  discount            Float   @default(0)
  productName         String?
  productSku          String?
  productUnit         String?
  productHsnCode      String?
  productGstRate      Float?
  productCategory     String?
  // ── Phase 2: Price override audit ──
  originalPrice       Float? // price from product master before override
  priceOverrideReason String? // reason code: customer_negotiation, clearance_sale, etc.
  product             Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale                Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

// ── Phase 2: Split payments ──
model SalePayment {
  id            String   @id @default(cuid())
  saleId        String
  paymentMethod String // cash | upi | card | bank_transfer | cheque
  amount        Float
  reference     String? // UPI ref, card last 4, cheque no
  notes         String?
  createdBy     String? // userId who recorded the payment
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model CreditNote {
  id           String   @id @default(cuid())
  creditNoteNo String   @unique
  saleId       String
  customerId   String
  reason       String
  amount       Float
  taxAmount    Float    @default(0)
  notes        String?
  businessId   String
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model DebitNote {
  id          String   @id @default(cuid())
  debitNoteNo String   @unique
  saleId      String
  customerId  String
  reason      String
  amount      Float
  taxAmount   Float    @default(0)
  notes       String?
  businessId  String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model BillOfSupply {
  id         String             @id @default(cuid())
  billNo     String             @unique
  customerId String
  total      Float
  paid       Float              @default(0)
  status     String
  supplyType String
  notes      String?
  businessId String
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id])
  customer   Customer           @relation(fields: [customerId], references: [id])
  items      BillOfSupplyItem[]
}

model BillOfSupplyItem {
  id              String       @id @default(cuid())
  billOfSupplyId  String
  productId       String
  qty             Int
  price           Float
  purchasePrice   Float        @default(0) // Immutable snapshot of COGS at time of sale
  hsnCode         String?
  productName     String?
  productSku      String?
  productUnit     String?
  productHsnCode  String?
  productGstRate  Float?
  productCategory String?
  billOfSupply    BillOfSupply @relation(fields: [billOfSupplyId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Quotation {
  id            String          @id @default(cuid())
  quotationNo   String
  customerId    String
  total         Float
  notes         String?
  placeOfSupply String?
  reverseCharge Boolean         @default(false)
  businessId    String
  createdAt     DateTime        @default(now())
  validUntil    DateTime?
  business      Business        @relation(fields: [businessId], references: [id])
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         QuotationItem[]

  @@unique([businessId, quotationNo])
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  productId       String
  qty             Int
  price           Float
  purchasePrice   Float     @default(0) // Immutable snapshot of COGS at time of quotation
  discount        Float     @default(0)
  hsnCode         String?
  gstRate         Float     @default(0)
  productName     String?
  productSku      String?
  productUnit     String?
  productHsnCode  String?
  productGstRate  Float?
  productCategory String?
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Expense {
  id                 String                     @id @default(cuid())
  category           String
  amount             Float
  note               String?
  date               DateTime
  recurring          Boolean                    @default(false)
  businessId         String
  invoiceNumbers     String[]                   @default([])
  excludedProductIds String[]                   @default([])
  createdAt          DateTime                   @default(now())
  business           Business                   @relation(fields: [businessId], references: [id])
  expenseAllocations ExpenseAllocationHistory[]
}

model Employee {
  id                String             @id @default(cuid())
  userId            String?            @unique
  name              String
  email             String
  phone             String?
  role              Role               @default(STAFF)
  department        String
  designation       String?
  permissions       Json?
  salary            Float
  joinDate          DateTime
  status            String             @default("INVITATION_SENT")
  attendance        Int                @default(100)
  businessId        String
  createdAt         DateTime           @default(now())
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  attendanceTickets AttendanceTicket[]
  business          Business           @relation(fields: [businessId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])

  @@unique([businessId, email])
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  employeeId String
  date       String
  status     String
  note       String?
  businessId String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model LeaveRequest {
  id         String    @id @default(cuid())
  employeeId String
  businessId String
  type       String // sick | casual | annual | unpaid | other
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote  String?
  appliedAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String? // userId of admin
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  business   Business  @relation(fields: [businessId], references: [id])
}

/// Employee raises a ticket when their recorded attendance is wrong.
/// Super Admin reviews, corrects the record, and closes the ticket.
model AttendanceTicket {
  id             String    @id @default(cuid())
  employeeId     String
  businessId     String
  date           String // YYYY-MM-DD of the disputed day
  recordedStatus String? // what's in the DB (present/absent/leave/half_day)
  expectedStatus String // what the employee claims it should be
  issue          String // free-text description of the problem
  status         String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | REJECTED
  adminNote      String? // admin's resolution message
  resolvedBy     String? // userId of admin
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  business       Business  @relation(fields: [businessId], references: [id])

  @@unique([employeeId, date]) // one active ticket per day per employee
}

model Notification {
  id         String   @id @default(cuid())
  type       String
  title      String
  message    String
  read       Boolean  @default(false)
  priority   String   @default("normal") // low | normal | high | urgent
  category   String   @default("general") // inventory | finance | gst | crm | general
  sourceType String? // sale | payment | stock | loan | gst | ai
  sourceId   String? // ID of the entity that triggered this notification
  businessId String
  targetRole String? // null = visible to all; set to a Role value to restrict (e.g. "SUPER_ADMIN")
  userId     String? // null = role-broadcast; set to target a specific user for personal notifications
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, category])
  @@index([businessId, read])
}

model UserActivity {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  userName   String   @default("")
  eventType  String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([businessId, userId])
}

/// Server-side refresh tokens for mobile JWT auth.
/// Stored in DB so they can be explicitly revoked on logout.
model RefreshToken {
  id         String    @id @default(cuid())
  token      String    @unique // random 64-byte hex
  userId     String
  businessId String
  expiresAt  DateTime
  revokedAt  DateTime? // null = still valid
  userAgent  String? // device info from User-Agent header
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

/// FCM / APNs device tokens for push notifications.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // FCM registration token
  platform  String // "android" | "ios" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  SALES_EXECUTIVE
  STORE_MANAGER
  EMPLOYEE
  MANAGER // @deprecated — kept for migration compatibility
  STAFF // @deprecated — kept for migration compatibility
  CUSTOM_ROLE
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

// ═══════════════════════════════════════════════════════════════════════════════
// Accounting & Finance
// ═══════════════════════════════════════════════════════════════════════════════

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum TransactionType {
  RECEIPT
  PAYMENT
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  UNMATCHED
}

enum LoanType {
  TERM_LOAN
  PERSONAL_LOAN
  BUSINESS_LOAN
  HOME_LOAN
  VEHICLE_LOAN
  GOLD_LOAN
  WORKING_CAPITAL
  OTHER
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
  RESTRUCTURED
  FORECLOSED
  OVERDUE
}

enum EMIStatus {
  PENDING
  PAID
  OVERDUE
  PARTIALLY_PAID
}

/// Chart of Accounts — hierarchical account tree for double-entry bookkeeping.
/// Account codes and names are user-defined (not hardcoded).
model Account {
  id              String          @id @default(cuid())
  code            String // e.g. "1000", "2100" — user-defined
  name            String // e.g. "Cash in Hand", "Trade Receivables"
  accountType     AccountType // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  parentId        String? // self-referencing for sub-accounts
  description     String?
  openingBalance  Float           @default(0)
  isActive        Boolean         @default(true)
  isSystemAccount Boolean         @default(false) // true for auto-created defaults
  businessId      String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  parent          Account?        @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]       @relation("AccountHierarchy")
  business        Business        @relation(fields: [businessId], references: [id])
  journalLines    JournalLine[]
  cashBookEntries CashBookEntry[]
  bankBookEntries BankBookEntry[]

  @@unique([businessId, code])
  @@index([businessId, accountType])
}

/// Journal Entry — the header for a set of balanced debit/credit lines.
model JournalEntry {
  id          String        @id @default(cuid())
  entryNumber String // auto-generated: JE-0001, JE-0002, etc.
  date        DateTime
  narration   String // description / memo
  reference   String? // external ref (invoice no, cheque no, etc.)
  status      JournalStatus @default(DRAFT)
  totalAmount Float         @default(0) // sum of debits (= sum of credits when balanced)
  businessId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    Business      @relation(fields: [businessId], references: [id])
  lines       JournalLine[]

  @@unique([businessId, entryNumber])
  @@index([businessId, date])
}

/// Journal Line — individual debit or credit entry within a journal entry.
model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float        @default(0)
  credit         Float        @default(0)
  narration      String?
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

/// Accounts Receivable — tracks money owed TO the business by customers.
model AccountsReceivable {
  id         String   @id @default(cuid())
  customerId String
  invoiceRef String // reference to sale/invoice
  amount     Float // original invoice amount
  paidAmount Float    @default(0)
  dueDate    DateTime
  status     String   @default("OUTSTANDING") // OUTSTANDING, PARTIALLY_PAID, PAID, OVERDUE
  notes      String?
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, status])
  @@index([businessId, dueDate])
}

/// Accounts Payable — tracks money owed BY the business to suppliers/vendors.
model AccountsPayable {
  id           String   @id @default(cuid())
  supplierName String
  invoiceRef   String // supplier invoice reference
  amount       Float
  paidAmount   Float    @default(0)
  dueDate      DateTime
  status       String   @default("OUTSTANDING") // OUTSTANDING, PARTIALLY_PAID, PAID, OVERDUE
  category     String? // e.g. "Raw Material", "Services"
  notes        String?
  businessId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id])

  @@index([businessId, status])
  @@index([businessId, dueDate])
}

/// Cash Book — records all cash receipts and payments.
model CashBookEntry {
  id              String          @id @default(cuid())
  date            DateTime
  transactionType TransactionType // RECEIPT or PAYMENT
  accountId       String // which ledger account this hits
  amount          Float
  narration       String
  reference       String? // voucher/receipt number
  businessId      String
  createdAt       DateTime        @default(now())
  account         Account         @relation(fields: [accountId], references: [id])
  business        Business        @relation(fields: [businessId], references: [id])

  @@index([businessId, date])
}

/// Bank Account — bank accounts associated with the business.
model BankAccount {
  id              String               @id @default(cuid())
  accountName     String // e.g. "HDFC Current Account"
  bankName        String
  accountNumber   String
  ifscCode        String?
  branch          String?
  currentBalance  Float                @default(0)
  isActive        Boolean              @default(true)
  businessId      String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  business        Business             @relation(fields: [businessId], references: [id])
  bankBookEntries BankBookEntry[]
  reconciliations BankReconciliation[]

  @@unique([businessId, accountNumber])
}

/// Bank Book — records all bank transactions (deposits, withdrawals, transfers).
model BankBookEntry {
  id                   String               @id @default(cuid())
  date                 DateTime
  transactionType      TransactionType // RECEIPT or PAYMENT
  bankAccountId        String
  accountId            String // ledger account
  amount               Float
  narration            String
  reference            String? // cheque no, NEFT ref, etc.
  reconciliationStatus ReconciliationStatus @default(PENDING)
  reconciliationDate   DateTime?
  businessId           String
  createdAt            DateTime             @default(now())
  bankAccount          BankAccount          @relation(fields: [bankAccountId], references: [id])
  account              Account              @relation(fields: [accountId], references: [id])
  business             Business             @relation(fields: [businessId], references: [id])

  @@index([businessId, date])
  @@index([bankAccountId, reconciliationStatus])
}

/// Bank Reconciliation — reconciliation session for matching bank statements.
model BankReconciliation {
  id                  String      @id @default(cuid())
  bankAccountId       String
  statementDate       DateTime
  statementBalance    Float
  bookBalance         Float
  adjustedBalance     Float?
  reconciledEntries   Json? // array of bankBookEntry IDs that were matched
  unreconciledEntries Json? // array of bankBookEntry IDs not matched
  notes               String?
  status              String      @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  businessId          String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  bankAccount         BankAccount @relation(fields: [bankAccountId], references: [id])
  business            Business    @relation(fields: [businessId], references: [id])

  @@index([businessId, bankAccountId])
}

/// GST Return — tracks GST filing data per period.
model GstReturn {
  id           String    @id @default(cuid())
  period       String // "2024-01", "2024-Q1", etc.
  returnType   String // "GSTR1", "GSTR3B", "GSTR9", etc.
  filingDate   DateTime?
  status       String    @default("PENDING") // PENDING, FILED, REVISED
  totalTaxable Float     @default(0)
  totalCgst    Float     @default(0)
  totalSgst    Float     @default(0)
  totalIgst    Float     @default(0)
  totalCess    Float     @default(0)
  totalTax     Float     @default(0)
  data         Json? // detailed breakdown per rate slab
  notes        String?
  businessId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  business     Business  @relation(fields: [businessId], references: [id])

  @@unique([businessId, period, returnType])
}

/// TDS Entry — tracks TDS deductions made by the business.
model TdsEntry {
  id            String    @id @default(cuid())
  section       String // e.g. "194C", "194J" — user-entered
  deducteeName  String
  deducteePan   String?
  paymentDate   DateTime
  paymentAmount Float
  tdsRate       Float // percentage
  tdsAmount     Float
  depositDate   DateTime?
  challanNo     String?
  status        String    @default("DEDUCTED") // DEDUCTED, DEPOSITED, FILED
  notes         String?
  businessId    String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, section])
  @@index([businessId, paymentDate])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Loan & EMI Management
// ═══════════════════════════════════════════════════════════════════════════════

/// Loan Master — definition of a loan with all parameters.
model LoanMaster {
  id                 String         @id @default(cuid())
  loanNumber         String // auto-generated: LOAN-0001
  borrowerName       String // who took the loan
  loanType           LoanType       @default(TERM_LOAN)
  amount             Float // principal amount
  interestRate       Float // annual interest rate (%)
  tenure             Int // in months
  startDate          DateTime
  endDate            DateTime? // computed from start + tenure
  emiAmount          Float? // computed EMI amount
  totalInterest      Float? // total interest over loan life
  totalPayable       Float? // principal + total interest
  outstandingBalance Float? // current outstanding
  status             LoanStatus     @default(ACTIVE)
  lender             String? // SBI, HDFC, ICICI, NBFC, etc.
  purpose            String? // Business Expansion, Working Capital, etc.
  notes              String?
  businessId         String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  business           Business       @relation(fields: [businessId], references: [id])
  schedule           LoanSchedule[]
  payments           LoanPayment[]
  documents          LoanDocument[]

  @@unique([businessId, loanNumber])
  @@index([businessId, status])
}

/// Loan Schedule — pre-computed EMI schedule (one row per EMI installment).
model LoanSchedule {
  id                String     @id @default(cuid())
  loanId            String
  installmentNumber Int
  dueDate           DateTime
  emiAmount         Float
  principalAmount   Float
  interestAmount    Float
  openingBalance    Float
  closingBalance    Float
  status            EMIStatus  @default(PENDING)
  paidDate          DateTime?
  paidAmount        Float?
  loan              LoanMaster @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installmentNumber])
  @@index([loanId, status])
  @@index([dueDate])
}

/// Loan Payment — actual payments recorded against a loan.
model LoanPayment {
  id            String     @id @default(cuid())
  loanId        String
  paymentDate   DateTime
  amount        Float
  principalPaid Float      @default(0)
  interestPaid  Float      @default(0)
  paymentType   String     @default("EMI") // EMI, PREPAYMENT, PARTIAL, CLOSURE
  reference     String? // cheque/txn reference
  notes         String?
  createdAt     DateTime   @default(now())
  loan          LoanMaster @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, paymentDate])
}

/// Loan Document — files attached to a loan (agreement, KYC, sanction letter, etc.).
model LoanDocument {
  id        String     @id @default(cuid())
  loanId    String
  name      String // display name
  docType   String     @default("OTHER") // AGREEMENT | SANCTION | KYC | PAN | AADHAAR | PROPERTY | OTHER
  // A-5 FIX Advisory: Storing base64 encoded files directly in the DB will cause
  // rapid database bloat. Recommend migrating to S3, R2, or Vercel Blob storage 
  // and storing the URL/key here instead before production scale.
  fileData  String // base64 encoded file content
  mimeType  String? // e.g. application/pdf, image/png
  fileSize  Int? // bytes
  createdAt DateTime   @default(now())
  loan      LoanMaster @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Security & Administration
// ═══════════════════════════════════════════════════════════════════════════════

/// Custom Role — user-defined roles with fine-grained permission sets.
model CustomRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions String[] // array of Permission key strings
  businessId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
}

/// Audit Log — immutable, tamper-evident record of every data mutation.
model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String // who performed the action
  userName    String // denormalized for display
  action      String // CREATE | UPDATE | DELETE
  entityType  String // "Sale", "Product", "Employee", etc.
  entityId    String // ID of the affected record
  entityLabel String? // human-readable label (e.g. invoice no)
  changes     Json? // { field: { old: ..., new: ... } }
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([businessId, entityType])
  @@index([businessId, userId])
}

/// Backup Record — tracks manual and automated data backups.
model BackupRecord {
  id          String   @id @default(cuid())
  businessId  String
  type        String   @default("MANUAL") // MANUAL | SCHEDULED | AUTO
  status      String   @default("COMPLETED") // IN_PROGRESS | COMPLETED | FAILED
  fileSize    Int? // bytes
  fileName    String?
  storageUrl  String? // S3/R2 URL if cloud-synced
  triggeredBy String? // userId
  notes       String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Automation & AI
// ═══════════════════════════════════════════════════════════════════════════════

/// Automation Settings — per-business feature toggles for automation modules.
model AutomationSettings {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  autoGst              Boolean  @default(true)
  autoJournal          Boolean  @default(true)
  autoStockUpdate      Boolean  @default(true)
  autoReorderAlert     Boolean  @default(true)
  aiForecast           Boolean  @default(false)
  aiInsights           Boolean  @default(false)
  emailNotifications   Boolean  @default(true)
  whatsappButton       Boolean  @default(true)
  // ── Inventory Costing ──
  costingMethod        String   @default("FIFO") // FIFO | LIFO | WAC | SPECIFIC | STANDARD
  landedCostAllocation String   @default("BY_QUANTITY") // BY_QUANTITY | BY_WEIGHT | BY_VOLUME | BY_VALUE | MANUAL
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  business             Business @relation(fields: [businessId], references: [id])
}

/// Warehouse — physical storage locations for inventory tracking.
model Warehouse {
  id              String           @id @default(cuid())
  name            String
  location        String?
  isDefault       Boolean          @default(false)
  businessId      String
  createdAt       DateTime         @default(now())
  business        Business         @relation(fields: [businessId], references: [id])
  stockMovements  StockMovement[]
  inventoryLayers InventoryLayer[]

  @@unique([businessId, name])
}

/// AI Forecast — cached AI-generated forecasts and insights.
model AiForecast {
  id          String   @id @default(cuid())
  businessId  String
  type        String // "demand" | "sales" | "insight"
  period      String // "2026-07" or "2026-Q3" or "daily"
  data        Json // forecast results / insight array
  confidence  Float? // overall confidence score (0-100)
  generatedAt DateTime @default(now())
  expiresAt   DateTime // cache expiry — re-generate after this
  business    Business @relation(fields: [businessId], references: [id])

  @@index([businessId, type])
  @@index([businessId, expiresAt])
}

enum MovementType {
  IN
  OUT
  ADJUST
  TRANSFER
}

/// Append-only ledger for all inventory movements
model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  warehouseId String? // nullable for now if warehouses aren't strictly enforced
  type        MovementType
  quantity    Int // Positive for IN, negative for OUT
  referenceId String? // e.g., saleId, billOfSupplyId, or user note
  notes       String?
  businessId  String
  createdAt   DateTime     @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, productId])
  @@index([businessId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Inventory Layer Costing
// ═══════════════════════════════════════════════════════════════════════════════

/// Inventory Layer — each stock receipt creates a separate cost layer for FIFO/LIFO consumption.
model InventoryLayer {
  id          String  @id @default(cuid())
  itemId      String // FK → Product
  warehouseId String? // FK → Warehouse

  receiptNo   String? // Purchase invoice / GRN number
  receiptDate DateTime @default(now())

  originalQty  Float // Quantity received
  remainingQty Float // Current remaining

  purchaseCost Float // Base purchase cost (total)
  landedCost   Float // Total landed cost (purchase + all expenses)
  unitCost     Float // landedCost / originalQty

  status String @default("ACTIVE") // ACTIVE | EXHAUSTED | RETURNED

  // ── Batch / Lot Tracking ──
  batchNo    String?
  lotNo      String?
  mfgDate    DateTime?
  expiryDate DateTime?

  // ── Supplier Reference ──
  supplierId          String? // Supplier name or future FK
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  purchaseInvoiceId   String? // Link to purchase receipt

  // ── Multi-Currency ──
  currencyCode  String @default("INR") // ISO 4217
  exchangeRate  Float  @default(1) // Exchange rate to base currency
  foreignAmount Float? // Amount in foreign currency

  // ── Transfer Tracking ──
  transferredFromLayerId String? // Source layer if created by transfer
  sourceTransactionId    String? // Source transaction that created this layer
  sourceTransactionType  String? // "purchase" | "transfer" | "production" | "return" | "adjustment"

  // ── Flags ──
  isAdjustment          Boolean @default(false) // True if created by stock count adjustment
  costingMethodSnapshot String? // Costing method at time of creation

  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  product            Product                     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse          Warehouse?                  @relation(fields: [warehouseId], references: [id])
  business           Business                    @relation(fields: [businessId], references: [id])
  purchaseInvoice    Purchase?                   @relation(fields: [purchaseInvoiceId], references: [id])
  costs              InventoryLayerCost[]
  consumptions       InventoryLayerConsumption[]
  serials            InventorySerial[]
  costAdjustments    InventoryCostAdjustment[]
  revaluations       InventoryRevaluation[]
  expenseAllocations ExpenseAllocationHistory[]

  @@index([businessId, itemId])
  @@index([businessId, itemId, warehouseId])
  @@index([businessId, status])
  @@index([batchNo])
  @@index([expiryDate])
}

/// Inventory Layer Cost — breakdown of each expense component in a layer.
model InventoryLayerCost {
  id          String   @id @default(cuid())
  layerId     String
  expenseType String // "purchase_cost" | "transport" | "loading" | "unloading" | "insurance" | "customs" | "freight" | "other"
  amount      Float
  remarks     String?
  createdAt   DateTime @default(now())

  layer InventoryLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@index([layerId])
}

/// Expense Allocation History — tracks historical allocations and edits
model ExpenseAllocationHistory {
  id        String   @id @default(cuid())
  expenseId String
  layerId   String
  oldAmount Float
  newAmount Float
  action    String // "ALLOCATED" | "EDITED" | "DELETED"
  createdAt DateTime @default(now())

  layer   InventoryLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  expense Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([layerId])
}

/// Inventory Layer Consumption — tracks which layer was consumed by each transaction.
model InventoryLayerConsumption {
  id              String   @id @default(cuid())
  transactionId   String // Sale ID, BOS ID, transfer ID, etc.
  transactionType String // "sale" | "bill_of_supply" | "purchase_return" | "transfer" | "production" | "adjustment" | "manual"
  layerId         String
  quantity        Float
  unitCost        Float // Unit cost at time of consumption
  amount          Float // quantity × unitCost
  businessId      String
  createdAt       DateTime @default(now())

  layer    InventoryLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  business Business       @relation(fields: [businessId], references: [id])

  @@index([transactionId])
  @@index([layerId])
  @@index([businessId, createdAt])
  @@index([transactionId, transactionType])
}

/// Inventory Serial — per-unit serial/IMEI tracking linked to layers (Phase 2).
model InventorySerial {
  id           String   @id @default(cuid())
  layerId      String
  serialNumber String
  imei         String?
  status       String   @default("IN_STOCK") // IN_STOCK | SOLD | RETURNED | DAMAGED
  soldToId     String? // Customer ID if sold
  saleItemId   String? // Link to SaleItem
  businessId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  layer InventoryLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@unique([businessId, serialNumber])
  @@index([layerId])
  @@index([businessId, status])
}

/// Inventory Revaluation — manual or system-triggered cost revaluation (Phase 2).
model InventoryRevaluation {
  id               String   @id @default(cuid())
  layerId          String
  reason           String // "damage" | "market_adjustment" | "obsolescence" | "quality_issue" | "manual"
  oldUnitCost      Float
  newUnitCost      Float
  oldLandedCost    Float
  newLandedCost    Float
  quantityAffected Float // remainingQty at time of revaluation
  impactAmount     Float // (newUnitCost - oldUnitCost) × quantityAffected
  journalEntryId   String? // Link to the GL entry posted
  notes            String?
  performedBy      String? // userId
  businessId       String
  createdAt        DateTime @default(now())

  layer InventoryLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@index([layerId])
  @@index([businessId, createdAt])
}

/// Inventory Cost Adjustment — handles late landed cost invoices after partial consumption.
model InventoryCostAdjustment {
  id                   String   @id @default(cuid())
  layerId              String
  expenseType          String // Same expense types as InventoryLayerCost
  totalAmount          Float // Total expense amount
  allocatedToRemaining Float // Portion allocated to remaining inventory
  allocatedToConsumed  Float // Portion allocated to already-sold COGS
  oldUnitCost          Float
  newUnitCost          Float
  journalEntryId       String? // COGS adjustment journal entry
  remarks              String?
  businessId           String
  createdAt            DateTime @default(now())

  layer InventoryLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@index([layerId])
  @@index([businessId, createdAt])
}

/// Inventory Period Closing — month-end / period-end inventory snapshots (Phase 2).
model InventoryPeriodClosing {
  id            String   @id @default(cuid())
  period        String // "2026-03", "2026-Q1", etc.
  closingDate   DateTime
  status        String   @default("OPEN") // OPEN | CLOSED | LOCKED
  totalItems    Int
  totalQuantity Float
  totalValue    Float // Sum of all layer values at close
  snapshotData  Json // Full layer snapshot
  closedBy      String? // userId
  businessId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, period])
  @@index([businessId, closingDate])
}

/// Stock Count — physical stock verification records (Phase 2).
model StockCount {
  id               String   @id @default(cuid())
  countNo          String // Auto: SC-2026-001
  countDate        DateTime
  warehouseId      String?
  status           String   @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETED | APPROVED
  totalVariance    Float    @default(0) // Net quantity variance
  totalValueImpact Float    @default(0) // Net value impact of adjustments
  journalEntryId   String? // Adjustment journal
  approvedBy       String?
  notes            String?
  businessId       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  items    StockCountItem[]
  business Business         @relation(fields: [businessId], references: [id])

  @@unique([businessId, countNo])
  @@index([businessId, status])
}

/// Stock Count Item — individual product lines within a stock count (Phase 2).
model StockCountItem {
  id             String  @id @default(cuid())
  stockCountId   String
  productId      String
  warehouseId    String?
  systemQty      Float // What ERP says we should have
  physicalQty    Float // What was physically counted
  variance       Float // physicalQty - systemQty
  unitCost       Float // WAC or layer cost for valuation
  valueImpact    Float // variance × unitCost
  adjustmentType String? // "surplus" | "shortage" | "match"
  notes          String?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@index([stockCountId])
}

/// Bill of Material — manufacturing recipe / formula (Phase 2).
model BillOfMaterial {
  id             String   @id @default(cuid())
  finishedItemId String // FK → Product (finished good)
  bomNo          String // Auto: BOM-001
  name           String
  outputQty      Float    @default(1) // How many finished units one BOM produces
  laborCost      Float    @default(0)
  overheadCost   Float    @default(0)
  overheadType   String   @default("fixed") // "fixed" | "percentage"
  status         String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  notes          String?
  businessId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  components BillOfMaterialItem[]
  business   Business             @relation(fields: [businessId], references: [id])

  @@unique([businessId, bomNo])
  @@index([businessId, finishedItemId])
}

/// Bill of Material Item — raw material components for a BOM (Phase 2).
model BillOfMaterialItem {
  id        String  @id @default(cuid())
  bomId     String
  productId String // FK → Product (raw material)
  quantity  Float // Required qty per BOM output
  unit      String?
  notes     String?

  bom BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
}

/// ML-Trained Invoice Template — stores learned coordinate zones from sample PDFs.
/// Each template represents one invoice format (e.g., "Tally Sales", "Tally GST Composite").
model InvoiceTemplate {
  id           String   @id @default(cuid())
  name         String // Human-readable name, e.g., "AGROCHEM GST Invoice"
  fingerprint  String // Format fingerprint for fast matching
  templateData Json // Learned FormatConfig as JSON
  trainingMeta Json? // Training stats: accuracy, column count, etc.
  sampleCount  Int      @default(1) // How many samples trained this template
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, fingerprint])
  @@index([businessId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 3: Purchase & Supplier Module
// ═══════════════════════════════════════════════════════════════════════════════

model Supplier {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  gstNumber      String?
  city           String?
  state          String?
  stateCode      String?
  status         String   @default("active")
  dues           Float    @default(0) // Accounts Payable tracking
  totalPurchases Float    @default(0)
  businessId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  purchases Purchase[]
  products  Product[]

  @@index([businessId])
}

model Purchase {
  id             String    @id @default(cuid())
  purchaseNo     String
  invoiceNo      String?
  supplierId     String
  businessId     String
  purchaseDate   DateTime
  dueDate        DateTime?
  totalAmount    Float
  taxAmount      Float     @default(0)
  discountAmount Float     @default(0)
  paidAmount     Float     @default(0)
  status         String
  workflowState  String    @default("draft")
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business        Business             @relation(fields: [businessId], references: [id])
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]
  attachments     PurchaseAttachment[]
  inventoryLayers InventoryLayer[]

  @@unique([businessId, purchaseNo])
  @@index([businessId, supplierId])
}

model PurchaseItem {
  id          String @id @default(cuid())
  purchaseId  String
  productId   String
  quantity    Int
  unitPrice   Float
  discount    Float  @default(0)
  taxAmount   Float  @default(0)
  totalAmount Float

  createdAt DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model PurchaseAttachment {
  id         String   @id @default(cuid())
  purchaseId String
  fileName   String
  fileUrl    String
  mimeType   String?
  fileSize   Int?
  uploadedAt DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}
