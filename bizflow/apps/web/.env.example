# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/bizflow?sslmode=require"

# ── NextAuth ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── Resend (transactional email) ───────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# The verified "from" address for your Resend domain
RESEND_FROM_EMAIL="BizFlow <noreply@yourdomain.com>"

# ── Upstash Redis (rate limiting) ──────────────────────────────────────────────
# Get from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── Cron security ──────────────────────────────────────────────────────────────
# Used to protect /api/cron/* endpoints. Set in your deployment platform.
CRON_SECRET="generate-with: openssl rand -hex 32"

# ── Optional: App URL (used for invitation links) ──────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Mobile API Auth (Flutter / native mobile clients) ──────────────────────────
# Signs the short-lived access tokens (HS256 JWT, 15 min).
# Generate with: openssl rand -base64 32
# If not set, falls back to NEXTAUTH_SECRET (not recommended for production).
MOBILE_JWT_SECRET="generate-with: openssl rand -base64 32"

# Signs/verifies refresh token secrets (opaque, stored in DB — this is optional).
# If not set, falls back to NEXTAUTH_SECRET.
MOBILE_REFRESH_SECRET="generate-with: openssl rand -base64 32"

# ── Firebase Cloud Messaging (Push Notifications — Phase 2) ───────────────────
# Server key for sending FCM push notifications to mobile devices.
# Get from: Firebase Console → Project Settings → Cloud Messaging
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}' # JSON string
